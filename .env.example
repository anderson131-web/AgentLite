# Copy to .env and edit. .env is git-ignored; never commit real keys.
# Nothing here needs a paid key: the defaults run fully local on Ollama.

# --- Model selection ---------------------------------------------------------
# ollama (default, local) | azure_openai (Phase 9) | gemini (Phase 8)
LLM_PROVIDER=ollama
# qwen2.5:3b (fast, fits in 4 GB VRAM) | qwen2.5:7b (better, slower) | llama3.2:3b | qwen3:4b
LLM_MODEL=qwen2.5:3b
LLM_TEMPERATURE=0
LLM_TIMEOUT_S=120

# --- Ollama ------------------------------------------------------------------
# Native Windows install: http://localhost:11434
# From inside Docker (Phase 7): http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
# Capped at 8192 in code to stay within 4 GB VRAM.
OLLAMA_NUM_CTX=8192
# Embeddings for RAG. Local: ollama + nomic-embed-text (ollama pull nomic-embed-text).
# Cloud (no Ollama): EMBED_PROVIDER=gemini, EMBED_MODEL=gemini-embedding-001 (needs GOOGLE_API_KEY).
# Changing these requires re-running: python -m agentlite.ingest
EMBED_PROVIDER=ollama
EMBED_MODEL=nomic-embed-text

# --- API -----------------------------------------------------------------------
# Concurrent runs. Keep 1 for a single local GPU; raise for cloud providers.
RUN_WORKERS=1

# --- Folders (defaults are relative to the project root) ----------------------
# DATA_DIR=./data            # Chroma index, demo SQLite DB, run history
# DOCS_DIR=./docs            # files indexed by knowledge_search
# WORKSPACE_DIR=./workspace  # the only folder the file tools can touch

# --- Optional cloud providers (leave blank to disable) -----------------------
# Gemini via Google AI Studio. Create the key in a project WITHOUT billing so it
# stays on the free tier and can never be charged.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Azure OpenAI (pay per token, no free tier). LLM_MODEL / the model dropdown use
# the DEPLOYMENT name, not the model name.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Optional BigQuery tool (public datasets) ---------------------------------
# Set to enable bigquery_query. Auth: gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=
# Hard cap per query in bytes (default 1 GB; the free tier is 1 TB/month)
BIGQUERY_MAX_BYTES=1000000000
